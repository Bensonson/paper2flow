# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Credentials and local configuration: never commit these
.env
.env.*
!.env.example
auth.json
config.toml
.codex/

# Generated reports, source papers, and local launchers
/out/
/output/
/outputs/
/reports/
*.pdf
report.html
report.*.html
!assets/report.html
OPEN_REPORT.cmd
OPEN_REPORT.sh
OPEN_WITH_CODEX.cmd

# Runtime state, logs, temporary files, and editor/OS metadata
.runtime/
.paper2flow-runtime/
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
.idea/
.vscode/

# Public distribution allowlist. Local notes and future outputs stay private.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/LICENSE.zh-CN.md
!/NOTICE
!/SKILL.md
!/requirements.txt
!/agents/
/agents/*
!/agents/openai.yaml
!/assets/
/assets/*
!/assets/report.html
!/assets/workflow-design-en.svg
!/assets/workflow-design-zh.svg
!/references/
/references/*
!/references/analysis-guide.md
!/references/data-contract.md
!/references/node-questions.md
!/references/report-defaults.md
!/references/workflow.schema.json
!/scripts/
/scripts/*
!/scripts/agent_bridge.py
!/scripts/check_report_defaults.js
!/scripts/check_report_defaults.py
!/scripts/paper2flow.py
!/scripts/report_server.py
!/examples/
/examples/*
!/examples/emotion-concepts.html
!/README.md
!/README.zh-CN.md
!/examples/alphago/
/examples/alphago/*
!/examples/alphago/index.html
!/examples/alphago/en.png
!/examples/alphago/zh.png
!/examples/eht/
/examples/eht/*
!/examples/eht/index.html
!/examples/eht/en.png
!/examples/eht/zh.png
